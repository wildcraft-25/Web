<html>
<head>
    <title>External CSS</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h2>Welcome to HTML</h2>
    <h3>External Style Sheet</h3>

    <hr>

    <p>This is a paragraph with CSS styling.</p>

    <div class="box">
        This is a division tag.
    </div>

    <p>This is a <span>special text</span>.</p>

    <time>18 November 2026</time>

    <br><br>

    <img src="image.jpg" alt="Sample Image">

    <p id="special">This is an ID selector.</p>

</body>
</html>

#CSS

h2 {
    color: blue;
    text-align: center;
}

h3 {
    color: red;
}

hr {
    border: 2px solid black;
}

p {
    font-size: 18px;
    color: green;
}

div {
    background-color: lightyellow;
    padding: 15px;
}

span {
    color: red;
    font-weight: bold;
}

time {
    color: purple;
    font-style: italic;
}

img {
    width: 200px;
    height: 120px;
}

.box {
    border: 2px solid blue;
}

#special {
    color: orange;
    font-weight: bold;
}




