<!DOCTYPE html>
<html>
<head>
    <title>Online Newspaper</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Daily News</h1>
    <p>Your Daily Newspaper</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Politics</a>
    <a href="#">Sports</a>
</nav>

<main>
<section>
    <article>
        <h2>Latest News</h2>
        <p>India is developing in science and technology.</p>

        <figure>
            <img src="MODI.webp" width="200">
            <figcaption>Prime Minister of India</figcaption>
        </figure>
    </article>
</section>

<aside>
    <h3>Breaking News</h3>
    <p>Latest updates from India.</p>
</aside>

<section>
    <h2>News Table</h2>
    <table border="1">
        <tr>
            <th>Category</th>
            <th>News</th>
        </tr>
        <tr>
            <td>Sports</td>
            <td>India wins the match</td>
        </tr>
        <tr>
            <td>Science</td>
            <td>New technology launched</td>
        </tr>
    </table>
</section>
</main>

<footer>
    <p>Copyright 2026 Daily News</p>
</footer>

</body>
</html>

#CSS

body {
    background-color: lightyellow;
    font-family: Arial;
}

header {
    background-color: navy;
    color: white;
    text-align: center;
    padding: 15px;
}

nav {
    background-color: gray;
    padding: 10px;
}

nav a {
    color: white;
    margin: 15px;
}

section {
    background-color: white;
    padding: 15px;
}

article {
    color: darkblue;
    font-size: 18px;
}

aside {
    background-color: lightblue;
    padding: 10px;
}

img {
    width: 200px;
}

table {
    background-color: lightgray;
    font-size: 16px;
}

footer {
    background-color: navy;
    color: white;
    text-align: center;
    padding: 10px;
}
