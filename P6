<!DOCTYPE html>
<html>
<head>
    <title>Registration Form</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<h2>Student Registration Form</h2>

<form>
<table>
<tr>
    <td>Name:</td>
    <td><input type="text"></td>
</tr>
<tr>
    <td>USN:</td>
    <td><input type="text"></td>
</tr>
<tr>
    <td>Email:</td>
    <td><input type="email"></td>
</tr>
<tr>
    <td>Phone:</td>
    <td><input type="number"></td>
</tr>
<tr>
    <td>Semester:</td>
    <td>
        <input type="radio" name="sem"> 5
        <input type="radio" name="sem"> 6
        <input type="radio" name="sem"> 7
        <input type="radio" name="sem"> 8
    </td>
</tr>
<tr>
    <td>Section:</td>
    <td>
        <input type="radio" name="sec"> A
        <input type="radio" name="sec"> B
    </td>
</tr>
<tr>
    <td>DOB:</td>
    <td><input type="date"></td>
</tr>
<tr>
    <td>Gender:</td>
    <td>
        <input type="radio" name="gender"> Male
        <input type="radio" name="gender"> Female
    </td>
</tr>
<tr>
    <td>Hobbies:</td>
    <td>
        <input type="checkbox"> Reading
        <input type="checkbox"> Sports
        <input type="checkbox"> Music
    </td>
</tr>
<tr>
    <td></td>
    <td>
        <input type="submit" value="Submit">
        <input type="reset" value="Reset">
    </td>
</tr>
</table>
</form>

</body>
</html>

#CSS


body {
    background-color: lightblue;
    font-family: Arial;
}

h2 {
    text-align: center;
    color: blue;
}

table {
    margin: auto;
    background-color: white;
    padding: 20px;
}

td {
    padding: 8px;
}

input {
    padding: 5px;
}

